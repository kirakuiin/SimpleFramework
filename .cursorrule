# 生成规范

1. 每次更新代码时，请更新README.md文件，添加新的功能和修改的细节。
2. 测试用例的代码尽量符合BOC原则(build-operate-check)。
3. 测试用例的每个测试方法只测试单一功能。
4. 代码的公开接口和属性添加注释。
5. 生成git commit message时，如果有多个修改，用列表形式列出。

# C# source files
*.cs text diff=csharp

# Code style rules
[*.cs]
# Indentation
indent_style = space
indent_size = 4

# New lines
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Naming conventions
dotnet_naming_rule.interface_should_be_begins_with_i.severity = error
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.private_members_with_underscore.severity = suggestion
dotnet_naming_rule.private_members_with_underscore.symbols = private_fields
dotnet_naming_rule.private_members_with_underscore.style = prefix_underscore

# Code style preferences
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false

# Organization
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Documentation
dotnet_diagnostic.cs1591.severity = suggestion # Missing XML comment for publicly visible type or member

# Solution and project files
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Config files
*.json text
*.xml text
*.config text

# Documentation
*.md text diff=markdown
LICENSE text

# Global config
global.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Generated files to be ignored
*.Generated.cs binary 